@model EnrolmentsViewModel
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="mb-3">
    <p class="rd-eyebrow text-orange mb-1">Your races</p>
    <h1 class="rd-heading display-5 mb-0">My enrolments</h1>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-warning">@Model.Error</div>
}

@if (Model.Enrolments.Count == 0 && string.IsNullOrEmpty(Model.Error))
{
    <div class="rd-card text-center p-5">
        <i class="bi bi-ticket-perforated display-4 text-orange"></i>
        <h2 class="rd-heading h4 mt-3">You haven't entered any events yet</h2>
        <p class="text-muted">Find a race that suits you and enter in seconds.</p>
        <a class="btn btn-primary" asp-controller="Events" asp-action="Index">Browse events</a>
    </div>
}
else if (Model.Enrolments.Count > 0)
{
    <div class="rd-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Bib</th>
                        <th>Fee</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Enrolments)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventID">@e.EventName</a>
                            </td>
                            <td>@e.EventDate.ToString("d MMM yyyy")</td>
                            <td>@e.CategoryName</td>
                            <td><span class="rd-bib">@e.BibNumber</span></td>
                            <td>@Format.Currency(e.EntryFee)</td>
                            <td><span class="status-badge status-@e.Status.ToLowerInvariant()">@Format.StatusLabel(e.Status)</span></td>
                            <td class="text-end">
                                @if (e.Status == "Active")
                                {
                                    <form asp-action="Cancel" asp-route-id="@e.EnrolmentID" method="post" class="d-inline"
                                          onsubmit="return confirm('Cancel this entry?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
