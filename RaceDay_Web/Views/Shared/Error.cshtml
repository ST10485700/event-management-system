@{
    ViewData["Title"] = (string)ViewBag.Title;
}

<div class="rd-card text-center p-5 mx-auto" style="max-width: 560px;">
    <div class="rd-error-code">@ViewBag.Code</div>
    <h1 class="rd-heading h3 mb-2">@ViewBag.Title</h1>
    <p class="text-muted mb-4">@ViewBag.Message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house-fill"></i> Back to home
    </a>
</div>
