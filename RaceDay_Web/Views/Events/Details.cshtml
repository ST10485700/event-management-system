@model EventDetailsViewModel
@{
    ViewData["Title"] = Model.Event.Name;
    var ev = Model.Event;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Events</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ev.Name</li>
    </ol>
</nav>

@if (!string.IsNullOrEmpty(ev.BannerUrl))
{
    <img class="rd-event-banner rd-event-banner-lg" src="@ev.BannerUrl" alt="Banner for @ev.Name" />
}
else
{
    <div class="rd-event-banner rd-event-banner-lg rd-event-banner-empty"><i class="bi bi-lightning-charge-fill"></i></div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="rd-card">
            <span class="type-badge type-@ev.EventType.ToLowerInvariant()">@ev.EventType</span>
            <h1 class="rd-heading display-6 mt-2">@ev.Name</h1>

            <div class="d-flex flex-wrap gap-4 text-muted mb-3">
                <span><i class="bi bi-calendar-event text-orange"></i> @ev.EventDate.ToString("dddd, d MMMM yyyy")</span>
                <span><i class="bi bi-geo-alt-fill text-orange"></i> @ev.Location</span>
                @if (ev.DistanceKm.HasValue)
                {
                    <span><i class="bi bi-signpost-split-fill text-orange"></i> @ev.DistanceKm.Value.ToString("0.##") km</span>
                }
                @if (!string.IsNullOrEmpty(ev.OrganiserName))
                {
                    <span><i class="bi bi-person-badge-fill text-orange"></i> Organised by @ev.OrganiserName</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(ev.Description))
            {
                <p class="mb-0">@ev.Description</p>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="rd-card h-100">
            <h2 class="rd-heading h4">Race day</h2>
            @if (Model.IsPast)
            {
                <p class="text-muted mb-0">This event has already taken place, so entries are closed.</p>
            }
            else
            {
                <p class="text-muted mb-0">Pick a category below to enter. Your bib number is assigned as soon as you enter.</p>
            }
        </div>
    </div>
</div>

<h2 class="rd-heading h3 mt-5 mb-3">Categories</h2>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-warning">@Model.Error</div>
}

@if (Model.Categories.Count == 0 && string.IsNullOrEmpty(Model.Error))
{
    <div class="rd-card text-center text-muted">The organiser hasn't added any categories to this event yet.</div>
}
else
{
    <div class="rd-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Entry fee</th>
                        <th>Spots left</th>
                        <th class="text-end">Entry</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td class="fw-semibold">@c.Name</td>
                            <td>@c.DistanceKm.ToString("0.##") km</td>
                            <td>@Format.Currency(c.EntryFee)</td>
                            <td>@c.SpotsRemaining</td>
                            <td class="text-end">
                                @if (Model.MyEnrolmentStatus.TryGetValue(c.CategoryID, out var status))
                                {
                                    <span class="status-badge status-@status.ToLowerInvariant()">@Format.StatusLabel(status)</span>
                                }
                                else if (Model.IsPast)
                                {
                                    <span class="text-muted small">Entries closed</span>
                                }
                                else if (c.SpotsRemaining <= 0)
                                {
                                    <span class="status-badge status-cancelled">Full</span>
                                }
                                else
                                {
                                    <form asp-action="Enrol" method="post" class="d-inline">
                                        <input type="hidden" name="eventId" value="@ev.EventID" />
                                        <input type="hidden" name="categoryId" value="@c.CategoryID" />
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            <i class="bi bi-ticket-perforated-fill"></i> Enter event
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
