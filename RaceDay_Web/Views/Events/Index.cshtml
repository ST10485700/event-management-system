@model EventsIndexViewModel
@{
    ViewData["Title"] = "Events";
    var types = new[] { "Running", "Cycling", "Walking" };
}

<div class="d-flex flex-wrap justify-content-between align-items-end mb-3">
    <div>
        <p class="rd-eyebrow text-orange mb-1">Find your race</p>
        <h1 class="rd-heading display-5 mb-0">@(Model.IncludePast ? "All events" : "Upcoming events")</h1>
    </div>
    <span class="text-muted">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events") found</span>
</div>

<form method="get" asp-action="Index" class="rd-card rd-filter-bar mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="search">Search</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or keyword" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="eventType">Type</label>
            <select id="eventType" name="eventType" class="form-select">
                <option value="">All types</option>
                @foreach (var type in types)
                {
                    <option value="@type" selected="@(Model.EventType == type)">@type</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="location">Location</label>
            <input id="location" name="location" value="@Model.Location" class="form-control" placeholder="Any" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="from">From</label>
            <input id="from" type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="to">To</label>
            <input id="to" type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="includePast" name="includePast" value="true" checked="@Model.IncludePast" />
            <label class="form-check-label" for="includePast">Include past events</label>
        </div>
        <div class="ms-auto d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel-fill"></i> Filter</button>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-warning">@Model.Error</div>
}

@if (Model.Events.Count == 0 && string.IsNullOrEmpty(Model.Error))
{
    <div class="rd-card text-center p-5">
        <i class="bi bi-calendar-x display-4 text-orange"></i>
        <h2 class="rd-heading h4 mt-3">No events match your filters</h2>
        <p class="text-muted mb-0">Try a different search or clear the filters to see all upcoming events.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="rd-card rd-event-card d-flex flex-column">
                    @if (!string.IsNullOrEmpty(ev.BannerUrl))
                    {
                        <img class="rd-event-banner" src="@ev.BannerUrl" alt="Banner for @ev.Name" />
                    }
                    else
                    {
                        <div class="rd-event-banner rd-event-banner-empty"><i class="bi bi-lightning-charge-fill"></i></div>
                    }
                    <div class="card-body d-flex flex-column flex-grow-1">
                        <div>
                            <span class="type-badge type-@ev.EventType.ToLowerInvariant()">@ev.EventType</span>
                        </div>
                        <h2 class="rd-heading h4 mt-2 mb-2">@ev.Name</h2>
                        <p class="text-muted small mb-2">
                            <i class="bi bi-calendar-event"></i> @ev.EventDate.ToString("ddd, d MMM yyyy")
                            &nbsp;&middot;&nbsp;
                            <i class="bi bi-geo-alt-fill"></i> @ev.Location
                        </p>
                        @if (ev.DistanceKm.HasValue)
                        {
                            <p class="small mb-2"><i class="bi bi-signpost-split-fill text-orange"></i> @ev.DistanceKm.Value.ToString("0.##") km</p>
                        }
                        <p class="text-muted flex-grow-1">@Format.Truncate(ev.Description, 110)</p>
                        <a class="btn btn-primary w-100 mt-2" asp-action="Details" asp-route-id="@ev.EventID">View event</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
