@model CategoryFormModel
@{
    ViewData["Title"] = "Edit category";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Events">My events</a></li>
                <li class="breadcrumb-item"><a asp-action="Categories" asp-route-eventId="@Model.EventID">@Model.EventName</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit category</li>
            </ol>
        </nav>

        <div class="rd-card p-4 p-md-5">
            <h1 class="rd-heading display-6 mb-4">Edit category</h1>

            <form asp-action="EditCategory" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="CategoryID" />
                <input type="hidden" asp-for="EventID" />
                <input type="hidden" asp-for="EventName" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control form-control-lg" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control form-control-lg" />
                        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxParticipants" class="form-label"></label>
                        <input asp-for="MaxParticipants" type="number" min="1" class="form-control form-control-lg" />
                        <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="EntryFee" class="form-label"></label>
                    <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control form-control-lg" />
                    <span asp-validation-for="EntryFee" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check-lg"></i> Save changes</button>
                    <a asp-action="Categories" asp-route-eventId="@Model.EventID" class="btn btn-outline-secondary btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
